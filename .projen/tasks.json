{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --no-merges --oneline $LATEST_TAG..HEAD -E --grep '^(feat|fix){1}(\\([^()[:space:]]+\\))?(!)?:[[:blank:]]+.+'"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)",
        "HEAD_COMMIT": "$(git rev-parse --short HEAD)"
      },
      "steps": [
        {
          "exec": "git checkout -B \"scratch-$HEAD_COMMIT\"",
          "name": "save current HEAD in a \"scratch-<commit>\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under a \"scratch-<commit>\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compat": {
      "name": "compat",
      "description": "Perform API compatibility check against latest version",
      "steps": [
        {
          "execArgs": [
            "jsii-diff",
            "npm:@aws-cdk-containers/ecs-service-extensions",
            "-k",
            "--ignore-file",
            ".compatignore"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "jsii --silence-warnings=reserved-word"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "docgen": {
      "name": "docgen",
      "description": "Generate API.md from .jsii manifest",
      "steps": [
        {
          "execArgs": [
            "jsii-docgen",
            "-o",
            "API.md"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "yarn install --check-files"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "yarn install --check-files --frozen-lockfile"
        }
      ]
    },
    "integ": {
      "name": "integ",
      "description": "Run integration snapshot tests",
      "steps": [
        {
          "exec": "integ-runner --language typescript",
          "receiveArgs": true
        }
      ]
    },
    "integ:aliased-port:assert": {
      "name": "integ:aliased-port:assert",
      "description": "assert the snapshot of integration test 'aliased-port'",
      "steps": [
        {
          "execArgs": [
            "node",
            "-e",
            "const [dir, name, task] = process.argv.slice(1); const stat = require('fs').statSync(dir, { throwIfNoEntry: false }); if (!stat || !stat.isDirectory()) { console.error(`No snapshot available for integration test '${name}'. Run 'projen ${task}' to capture.`); process.exit(1); }",
            "test/aliased-port.integ.snapshot",
            "aliased-port",
            "integ:aliased-port:deploy"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "synth",
            "--quiet",
            "--app",
            "ts-node -P test/tsconfig.json test/aliased-port.integ.ts",
            "--no-notices",
            "--no-version-reporting",
            "--no-asset-metadata",
            "--no-path-metadata",
            "-o",
            "test/.tmp/aliased-port.integ/assert.cdk.out"
          ]
        },
        {
          "execArgs": [
            "diff",
            "-r",
            "-x",
            "asset.*",
            "-x",
            "cdk.out",
            "-x",
            "manifest.json",
            "-x",
            "tree.json",
            "test/aliased-port.integ.snapshot/",
            "test/.tmp/aliased-port.integ/assert.cdk.out/"
          ]
        }
      ]
    },
    "integ:aliased-port:deploy": {
      "name": "integ:aliased-port:deploy",
      "description": "deploy integration test 'aliased-port' and capture snapshot",
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "test/.tmp/aliased-port.integ/deploy.cdk.out"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--app",
            "ts-node -P test/tsconfig.json test/aliased-port.integ.ts",
            "--no-notices",
            "--no-version-reporting",
            "--no-asset-metadata",
            "--no-path-metadata",
            "**",
            "--require-approval=never",
            "-o",
            "test/.tmp/aliased-port.integ/deploy.cdk.out"
          ]
        },
        {
          "execArgs": [
            "rm",
            "-fr",
            "test/aliased-port.integ.snapshot"
          ]
        },
        {
          "execArgs": [
            "mv",
            "test/.tmp/aliased-port.integ/deploy.cdk.out",
            "test/aliased-port.integ.snapshot"
          ]
        },
        {
          "spawn": "integ:aliased-port:destroy"
        }
      ]
    },
    "integ:aliased-port:destroy": {
      "name": "integ:aliased-port:destroy",
      "description": "destroy integration test 'aliased-port'",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy",
            "--app",
            "test/aliased-port.integ.snapshot",
            "**",
            "--no-version-reporting"
          ]
        }
      ]
    },
    "integ:aliased-port:snapshot": {
      "name": "integ:aliased-port:snapshot",
      "description": "update snapshot for integration test \"aliased-port\"",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth",
            "--quiet",
            "--app",
            "ts-node -P test/tsconfig.json test/aliased-port.integ.ts",
            "--no-notices",
            "--no-version-reporting",
            "--no-asset-metadata",
            "--no-path-metadata",
            "-o",
            "test/aliased-port.integ.snapshot"
          ]
        }
      ]
    },
    "integ:aliased-port:watch": {
      "name": "integ:aliased-port:watch",
